{
    "name": "initphp/auth",
    "description": "PHP authentication & authorization library with pluggable storage adapters (session, cookie, custom) and a small permission manager.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "auth",
        "authentication",
        "authorization",
        "permissions",
        "session",
        "cookie",
        "initphp"
    ],
    "autoload": {
        "psr-4": {
            "InitPHP\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InitPHP\\Auth\\Tests\\": "tests/"
        }
    },
    "support": {
        "source": "https://github.com/InitPHP/Auth",
        "issues": "https://github.com/InitPHP/Auth/issues"
    },
    "authors": [
        {
            "name": "Muhammet ŞAFAK",
            "email": "info@muhammetsafak.com.tr",
            "role": "Developer",
            "homepage": "https://www.muhammetsafak.com.tr"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "ext-hash": "*",
        "initphp/parameterbag": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html=build/coverage",
        "analyse": "phpstan analyse",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
